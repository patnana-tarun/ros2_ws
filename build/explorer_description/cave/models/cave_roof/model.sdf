<?xml version="1.0"?>
<sdf version="1.9">
  <model name="cave_roof">
    <static>true</static>
    <link name="roof">
      <visual name="ceiling">
        <geometry><mesh><uri>model://cave_roof/meshes/ceiling.obj</uri></mesh></geometry>
        <material>
          <diffuse>0.75 0.73 0.7 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
          <pbr><metal>
            <albedo_map>model://cave_rock/materials/textures/rock_albedo.png</albedo_map>
            <normal_map>model://cave_rock/materials/textures/rock_normal.png</normal_map>
            <roughness>0.7</roughness>
            <metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="stalactites">
        <geometry><mesh><uri>model://cave_roof/meshes/stalactites.obj</uri></mesh></geometry>
        <material>
          <diffuse>0.95 0.92 0.85 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
          <pbr><metal>
            <albedo_map>model://cave_rock/materials/textures/rock_albedo.png</albedo_map>
            <normal_map>model://cave_rock/materials/textures/rock_normal.png</normal_map>
            <roughness>0.4</roughness>
            <metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>

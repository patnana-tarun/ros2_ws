<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>explorer_bringup</name>
  <version>0.1.0</version>
  <description>
    Real-robot bringup for the explorer (runs on the Raspberry Pi): TB6612FNG motor and
    LM393 encoder driver, MPU-9250 IMU driver, and the launch that starts them with the
    LiDAR, robot_state_publisher and the odometry EKF.
  </description>
  <maintainer email="hansika9705@gmail.com">Patnana Tarun</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>explorer_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- On the Pi only (not needed for mock:=true): -->
  <exec_depend>python3-lgpio</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

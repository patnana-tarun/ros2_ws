<?xml version="1.0"?>
<!-- Gazebo Harmonic additions: wheel grip, skid-steer drive, joint states, 2D LiDAR.
     Included by explorer.urdf.xacro. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== Wheel grip (rubber on floor) ===== -->
  <xacro:macro name="wheel_grip" params="name">
    <gazebo reference="${name}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_grip name="left_front"/>
  <xacro:wheel_grip name="left_middle"/>
  <xacro:wheel_grip name="left_rear"/>
  <xacro:wheel_grip name="right_front"/>
  <xacro:wheel_grip name="right_middle"/>
  <xacro:wheel_grip name="right_rear"/>

  <gazebo>
    <!-- ===== Skid-steer drive: all 3 wheels per side get the same speed ===== -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_middle_wheel_joint</left_joint>
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_middle_wheel_joint</right_joint>
      <right_joint>right_rear_wheel_joint</right_joint>

      <wheel_separation>${2*wheel_y}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>

      <max_linear_velocity>0.5</max_linear_velocity>
      <max_angular_velocity>3.0</max_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>

      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <!-- ===== Publishes bogie + wheel angles for robot_state_publisher ===== -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>

    <!-- ===== Needed for any rendering sensor (the LiDAR) ===== -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <!-- ===== 2D LiDAR (generic placeholder until the YDLIDAR model is known) ===== -->
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>laser_frame</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
